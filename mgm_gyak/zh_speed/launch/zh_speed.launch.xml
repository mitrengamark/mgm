<launch>
    <!-- Start rosbag play -->
    <executable
        cmd="ros2 bag play --clock 1000 $(find-pkg-share gyak3)/bag"
        output="screen"
        name="rosbag_play"
        shell="true"
    />

    <!-- DistanceCalculator -->
    <node pkg="zh_speed" exec="distance_calculator" name="distance_calculator" output="screen" >
    </node>

    <!-- RVIZ -->
    <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(find-pkg-share zh_speed)/rviz/zh_speed.rviz"/>

</launch>